<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: only the rides, their summaries, the owner key's copy for the backup and the automatic
     options are backed up to the cloud, only when the backup is encrypted end to end, and copied to a new phone.
     Everything else stays out, auto-connect's settings among them: an include leaves out whatever it does not name. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="rides/" />
        <include domain="file" path="ride-summaries/" />
        <include domain="sharedpref" path="auto-connect.xml" />
        <include domain="sharedpref" path="owner-key-backup.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="rides/" />
        <include domain="file" path="ride-summaries/" />
        <include domain="sharedpref" path="auto-connect.xml" />
        <include domain="sharedpref" path="owner-key-backup.xml" />
    </device-transfer>
</data-extraction-rules>
