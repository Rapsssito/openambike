{
    "name": "openambike",
    "private": true,
    "license": "AGPL-3.0-only",
    "homepage": "https://github.com/Rapsssito/openambike",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Rapsssito/openambike.git"
    },
    "bugs": {
        "url": "https://github.com/Rapsssito/openambike/issues"
    },
    "type": "module",
    "engines": {
        "npm": ">=10.0.0",
        "node": ">=26.0.0 <27"
    },
    "scripts": {
        "checkjs": "tsc",
        "lint": "oxlint && oxfmt --check '**/*.{js,mjs,cjs,json,md}'",
        "lint:fix": "oxlint --fix && oxfmt '**/*.{js,mjs,cjs,json,md}'",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "ci-checks": "npm run checkjs && npm run lint && npm run test",
        "prepare": "node .husky/install.mjs",
        "commitlint": "commitlint --edit"
    },
    "workspaces": [
        "app"
    ],
    "jest": {
        "testEnvironment": "node",
        "roots": [
            "<rootDir>/app/src",
            "<rootDir>/app/scripts"
        ]
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.3",
        "@commitlint/config-conventional": "21.2.3",
        "@semantic-release/exec": "7.1.0",
        "@semantic-release/git": "11.0.1",
        "@types/jest": "30.0.0",
        "@types/node": "26.6.6",
        "husky": "9.1.7",
        "jest": "30.5.2",
        "jest-environment-node": "30.5.2",
        "oxfmt": "0.74.0",
        "oxlint": "1.88.0",
        "semantic-release": "26.0.1",
        "typescript": "7.0.2"
    }
}
